# Local credentials and machine-specific files
.env.local
.DS_Store
.obsidian/

# Hermes desktop internal state
.hermes/

# Local Python virtualenvs
.venv*/

# Next.js build output and installed dependencies
.next/
node_modules/
.vercel/
.env*
!.env.example
*.tsbuildinfo

# Playwright browser-test artifacts
test-results/
playwright-report/
blob-report/

# Cloudflare worker local preview secrets (wrangler dev reads .dev.vars)
.dev.vars

# OpenNext Cloudflare build output (contains build-time env; never commit)
.open-next/

# Wrangler local dev state (miniflare cache, sqlite)
.wrangler/

# Production build env for Cloudflare deploy (gitignored; CI uses GitHub secrets)
.env.production
.env.production.local

# Local-only access codes (never commit)
.secrets/

# Next.js generated type shim (regenerated on every build)
next-env.d.ts
