# Server-side only. Never expose this value through a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=

# Required. Access code that unlocks /audit and /api/audit/*. The middleware
# compares the httpOnly `nuave_access` cookie against this value and rejects
# mismatches before any route handler (and before any provider call) runs.
# Server-only; never expose it to the client. Use a long, non-guessable string.
NUAVE_ACCESS_CODE=

# Optional. The workflow records the exact model returned by the API.
OPENAI_AUDIT_MODEL=gpt-5.6-luna

# Optional. Overrides reasoning effort for every audit-stage API call.
OPENAI_AUDIT_REASONING_EFFORT=

# Server-enforced FLOOR on prior accounted spend (for example 0.3483): the
# effective carryover used by the cost guard is max(client-reported carryover,
# this value), so a client cannot lower it below what is set here. Left blank,
# the floor is 0 and the guard trusts the client-reported carryover entirely
# for a first-time or misconfigured deployment (O-6/O-7, Phase 3 fix-round-2
# adversarial review, 2026-08-18) — set this to the real cumulative spend
# before any deployment where the client is not fully trusted. This bounds
# only the carryover; the running per-session call ledger (`budget.calls`)
# is still entirely client-supplied with no server-side session store (a
# known, accepted gap for the founder-only private-run phase; see O-7 in
# `Adversary Review/Phase 3 - Fix Round 2.md` and `telemetry.ts`).
OPENAI_AUDIT_CARRYOVER_COST_USD=

# Optional. Server-controlled fixture-preview mode for the simulated journey.
# Accepts "true" or "1"; any other value disables the preview. Read only on the
# server — never expose it through a NEXT_PUBLIC_ variable. It is not a query
# parameter or client toggle. When disabled, the fixture route shows a safe
# unavailable state and the landing page keeps its normal behavior.
NUAVE_FIXTURE_PREVIEW_ENABLED=

# Optional. Local test configuration that forces the fixture report
# construction to fail, exercising the terminal example-preview error and
# retry/start-over recovery. Server-only, never customer-selectable, and never
# a fallback to a live API. Accepts "true" or "1".
NUAVE_FIXTURE_FORCE_REPORT_FAILURE=

# --- Local free testing: Google Gemini (no credit card) ---------------------
# Set NUAVE_PROVIDER=gemini to route the three audit calls (extraction,
# observations, report) through Gemini's free tier (3.1 Flash-Lite with Google
# Search grounding). Leave blank or set to "openai" for the paid OpenAI path.
NUAVE_PROVIDER=

# Server-side only. Gemini API key from https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Optional. Free model with Google Search grounding for new API keys.
GEMINI_AUDIT_MODEL=gemini-3.1-flash-lite

# --- Local free testing: Groq + Tavily (no credit card) ---------------------
# Set NUAVE_PROVIDER=groq to route the audit through Groq (LLM) + Tavily
# (web search), both free tiers. Groq gives the model; Tavily gives the web
# search that AI-visibility measurement needs. Leave blank for the paid OpenAI
# path. NOTE: a Tavily key is required for live search-grounded audits.
GROQ_API_KEY=
TAVILY_API_KEY=

# Optional. Free Groq model with JSON-mode structured output.
GROQ_AUDIT_MODEL=llama-3.3-70b-versatile

# --- Local free testing: OpenRouter (:free models, NO web search) -----------
# Set NUAVE_PROVIDER=openrouter to route the three audit calls (extraction,
# observations, report) through OpenRouter's `:free` model slugs. This is the
# cheapest way to exercise the pipeline end to end — contracts, retry policy,
# report assembly, journey states — at zero cost.
#
# LIMITATION, read before trusting any output: this path has NO web search.
# OpenRouter's own web plugin is paid per result and `:free` models have no
# hosted search, so answers come from model weights alone and every
# observation returns `sources: []`. Use it to test the PLUMBING. It cannot
# measure real AI visibility or judge report quality — for grounded answers at
# zero cost use NUAVE_PROVIDER=groq (Groq + Tavily), and for a real run use
# the locked OpenAI path.
#
# Free-tier limits are per REQUEST, not per token: ~20 requests/minute, and a
# per-day cap on `:free` models — 50/day under 10 lifetime credits, 1000/day
# at or above. One full audit is ~12 calls, so 50/day is about 4 runs.
# Server-side only. Key from https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Optional. Any `:free` slug from https://openrouter.ai/api/v1/models. The
# default advertises both `response_format` and `structured_outputs` (needed by
# the extraction and report stages) and was the slug actually serving requests
# when probed on 2026-08-19.
#
# Expect to change this. Free capacity is shared across every OpenRouter user,
# so any slug can return 429 "Provider returned error / temporarily
# rate-limited upstream" at any moment. That is the normal failure mode, not a
# bug in Nuave — switch to another slug and rerun:
#   z-ai/glm-5.2:free              (reasoning model; needs generous max_tokens)
#   google/gemma-4-26b-a4b-it:free
#   openai/gpt-oss-20b:free
# Avoid dots-studio/dots-3-note-preview:free — it returns content: null with
# the whole allowance spent on reasoning.
OPENROUTER_AUDIT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional. Per-request timeout in ms (default 90000). Free models queue behind
# paid traffic and can be slow; raise this before blaming the provider.
OPENROUTER_REQUEST_TIMEOUT_MS=

# --- Low-cost testing: OpenCode Go ($10/month subscription) ------------------
# Set NUAVE_PROVIDER=opencodego to route the three audit calls (extraction,
# observations, report) through OpenCode Go's Responses API — same gpt-5.6-luna
# model, same web search, same structured output, fraction of the cost.
# Requires an OpenCode Go subscription (https://opencode.ai/go).
NUAVE_PROVIDER=opencodego

# Server-side only. OpenCode Go API key from https://opencode.ai/auth.
OPENCODEGO_API_KEY=

# Required. Points the OpenAI SDK at OpenCode Go's Responses API endpoint.
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1

# --- Indonesian question writer (04 Questions) ------------------------------
# Optional. Provider for the bounded no-search question-generation call behind
# the Indonesian generation boundary (Spec 003 work package A): "openai"
# (default — OpenAI Responses API, GPT-5.6 Luna, low reasoning, no search,
# id-ID output) or "gemini" (Google Gemini, no search). This is independent
# from NUAVE_PROVIDER so the 03/04 provider defaults can differ until the
# five-business evaluation locks them (Spec 003 R-07..R-10). The model
# overrides reuse OPENAI_AUDIT_MODEL (default gpt-5.6-luna) and
# GEMINI_AUDIT_MODEL (default gemini-3.5-flash-lite for the question writer).
NUAVE_QUESTION_PROVIDER=
