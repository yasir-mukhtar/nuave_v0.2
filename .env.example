# Server-side provider configuration. Never expose credentials through a
# NEXT_PUBLIC_ variable.
#
# Production/live path (founder decision 2026-09-20): OpenAI's own Responses
# API serves GPT-5.6 Luna with hosted web search for the audit pipeline and
# Indonesian question writer. (The earlier OpenCode Go proxy was dropped when
# its subscription lapsed; Cheaper Inference serves the same model but silently
# ignores the web_search tool, so it cannot ground observations.)
NUAVE_PROVIDER=openai
NUAVE_QUESTION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_AUDIT_MODEL=gpt-5.6-luna
OPENAI_AUDIT_REASONING_EFFORT=low

# Server-side FLOOR on prior accounted spend (for example 0.4357) applied to the
# per-request guard. Browser-reported spend history is ignored; the daily
# spend limit below is the real cap.
OPENAI_AUDIT_CARRYOVER_COST_USD=

# Optional. Server-controlled fixture-preview mode for the simulated journey.
# Accepts "true" or "1"; any other value disables the preview. Read only on the
# server — never expose it through a NEXT_PUBLIC_ variable.
NUAVE_FIXTURE_PREVIEW_ENABLED=

# Optional. Local test configuration that forces the fixture report
# construction to fail, exercising the terminal example-preview error and
# retry/start-over recovery. Server-only, never customer-selectable.
NUAVE_FIXTURE_FORCE_REPORT_FAILURE=

# --- Testing-only provider alternatives -------------------------------------
# The protected live path rejects these providers in production. For explicit
# local test runs only, select an alternative below and set
# NUAVE_LIVE_PROVIDER_TESTING=1. That flag is ignored in NODE_ENV=production.
NUAVE_LIVE_PROVIDER_TESTING=

# Direct OpenAI Responses API testing. The live OpenCode Go path does not need
# this secret; deployment aliases OPENCODEGO_API_KEY to OPENAI_API_KEY only for
# the existing OpenAI SDK compatibility layer.
OPENAI_API_KEY=

# Google Gemini testing with Google Search grounding.
# Set NUAVE_PROVIDER=gemini for the audit stages and/or
# NUAVE_QUESTION_PROVIDER=gemini for the bounded no-search question writer.
GEMINI_API_KEY=
GEMINI_AUDIT_MODEL=gemini-3.1-flash-lite

# Groq + Tavily testing. Groq provides the model and Tavily provides web search.
# Set NUAVE_PROVIDER=groq. A Tavily key is required for search-grounded audits.
GROQ_API_KEY=
TAVILY_API_KEY=
GROQ_AUDIT_MODEL=llama-3.3-70b-versatile

# OpenRouter testing. `:free` models have no hosted web search in this path, so
# use this only to exercise pipeline plumbing, never to judge real visibility
# or report quality. Set NUAVE_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_AUDIT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Public trial journey (Spec 010) ----------------------------------------
# Serves the direct-ten audit journey at /audit and /api/audit/*. Accepts
# "true" or "1"; anything else returns 404 / "Audit tidak tersedia saat ini."
NUAVE_NEW_AUDIT_ENABLED=
# Server-selected execution mode: "live" uses the real providers (requires
# OPENCODEGO_API_KEY etc. and CHEAPERINFERENCE_API_KEY); anything else runs
# the labeled synthetic substitutes. Deployment sets "live".
NUAVE_AUDIT_MODE=
# Question generation (GLM 5.3 Flash via Cheaper Inference). Required in live
# mode on every audit stage so a missing key fails fast, not mid-journey.
CHEAPERINFERENCE_API_KEY=
# Optional. Local evidence runs only: when set, the live GLM send requires a
# frozen intake/request pair, consumes attempt.consumed, and preserves raw
# response bytes under this directory. Never set on the deployed worker —
# the route performs no filesystem writes without it.
NUAVE_GLM_EVIDENCE_DIR=

# Daily spend cap in USD (server-only, never from a request). Every paid
# provider call is recorded in the Cloudflare D1 binding SPEND_DB; new paid work
# is refused once today's (UTC) reserved + settled total would pass this limit.
# Blank means 5. In live mode a missing SPEND_DB binding refuses paid work.
NUAVE_DAILY_SPEND_LIMIT_USD=

# --- Orders and the server-side audit (Spec 016) ---------------------------
# Which deployment this is: "production" or "preview". wrangler.jsonc sets it
# per environment; leave blank locally (the `dev` environment supplies it).
NUAVE_ENVIRONMENT=
# The fixed site address a private report link is built on (never the request's
# host). wrangler.jsonc sets it per environment.
NUAVE_SITE_URL=
# Per-order cost limit in USD (server-only). Each live order holds this much of
# the daily cap until it ends. Blank means 2. A value that is not a number, is
# not above zero, or is above NUAVE_DAILY_SPEND_LIMIT_USD makes order creation
# fail closed.
NUAVE_ORDER_SPEND_LIMIT_USD=
# Live orders are accepted only from these email addresses (comma or space
# separated, matched without case). An empty or missing list allows no live
# order. A Cloudflare secret: never put real addresses in Git.
NUAVE_ORDER_EMAIL_ALLOWLIST=

# Optional. Per-request timeout in ms for OpenRouter (default 90000).
OPENROUTER_REQUEST_TIMEOUT_MS=
